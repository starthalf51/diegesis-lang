(* Diegesis 문법 — 단일 기준. internal/syntax 파서는 이 문법을 그대로 받는다.
   원본: vault projects/story-lang/language.md (v0) + 언어 추가 사항 + file-format.md 프론트매터.

   어휘
   - 한 줄에 한 문장. 블록은 들여쓰기 2칸(INDENT/DEDENT). 탭 들여쓰기와 2의 배수가 아닌 들여쓰기는 오류(rule indent).
   - 주석: "#" 부터 줄 끝까지. 단 "#!" 는 프라그마 토큰이다. 문자열 안의 "#" 은 글자다.
   - string = '"' { 글자 | '\"' | '\\' } '"' . 다른 역슬래시 이스케이프는 오류. 문자열 안의 "/" 는 글자다.
   - word   = wstart { wchar | ("." | "-" | "/") wchar } ;
     wstart = 유니코드 글자 | 숫자 | "_" | "@" ;  wchar = 유니코드 글자 | 숫자 | 결합 문자 | "_" | "?" ;
     word 하나가 ident, qname(macbeth.act1), sid(1.3, 4.1), tref(@1.3.ross_news, 1.3.ross_news, start),
     dur(0d, 65y), number(0.8), date(208-11, 1805-07-?), ruleid(belief-contradiction),
     ref(macbeth.act1/banquo_kings) 를 모두 덮는다. 뜻은 자리(문맥)로 정한다.
   - 구두점: ":" "," "(" ")" "=" ".." 그리고 프라그마 "#!".
   - 키워드는 문장 첫 단어와 둘째 단어로 고른다. 다만 다음 단어는 선언 id(decl 의 ident)로 쓸 수 없다
     (syntax "reserved word used as id"): when enter exit mention beat render reveal withhold setup payoff
     discourse parent born dies all not to with because src major minor extra

   표기: NL = 줄 끝, BLOCK(x) = NL INDENT { x NL } DEDENT, [ BLOCK(x) ] = 빈 몸체 허용. *)

file        = header { top } ;
header      = "module" qname NL { "import" qname NL } ;             (* module 두 번 → dup-decl, 같은 import 두 번 → dup-decl *)
top         = work | decl | scene | event | account | setup | distance | parent | life | belief | attribute | pragma ;
              (* 최상위 attribute = 처음부터 참(IR at_pt "") *)
              (* 최상위 belief = 배경 지식: 시점 없이 처음부터 믿는다(IR at_pt "") *)

(* 선언 *)
work        = "work" ident [string] [ BLOCK(wattr) ] ;
wattr       = "unit" ident | "start" date | name | pragma ;
decl        = kind ident [ string { "," string } ] [tier] [ "=" prop ] [bool] [ BLOCK(attr) ] ;
kind        = "character" | "group" | "place" | "thing" | "faction" | "role" | "fact" | "artifact" | "thread" ;
tier        = "major" | "minor" | "extra" ;
bool        = "true" | "false" ;
attr        = name
            | "members" idlist
            | "knows" ("oracle" | "omniscient")
            | "held" actor ( "from" tref [ "until" tref ] | "until" tref )
            | "shared"                                               (* 공동 보유 역할: 배타 제약 제외 *)
            | "contains" proplist
            | ("believes" | "doubts") prop                            (* character/group 만: 그 인물의 배경 지식 *)
            | attribute                                              (* 처음부터 참 *)
            | string                                                 (* artifact 본문 발췌 *)
            | pragma ;
name        = "name" ident string ;                                  (* 언어별 이름: name ko "맥베스" *)
distance    = "distance" ident ident dur ".." dur ;
parent      = "parent" ident "of" idlist ;
life        = ("born" | "dies") ident [ when ] ;                     (* 시점 @x.born / @x.died *)

(* 장면과 사건 *)
scene       = "scene" sid [ "at" ident ] [ "in" ident ] [ BLOCK(stmt) ] ;
event       = "event" ident [string] [ BLOCK(stmt) ] ;               (* 무대 밖 사건 *)
account     = "account" ident "of" qname "by" ident [ BLOCK(stmt) ] ; (* 같은 사건에 대한 기록 하나 *)

stmt        = when | presence | beat | act | belief | reader | render | setup | payoff
            | discourse | parent | life | attribute | pragma ;
when        = "when" ( ("after" | "before") tref [ "by" dur ".." dur ]
                     | "at" date [ident]                             (* 시각: dawn 등 *)
                     | "during" tref ) ;
presence    = "enter" idlist | "exit" "all" | "exit" idlist | "mention" idlist ;
beat        = "beat" ident ":" [ BLOCK(stmt) ] ;
act         = actor verb [ ident ] [ idlist ] [ "to" idlist ] [ "with" proplist ]
              [ ":" [prop] ] [ string ] [ "because" prop ] [ "src" (word | string) ] ;
              (* verb = "sees" 의 idlist 중 fact(별칭 포함)는 본 내용이다(with 로 들어간다). 나머지는 엔티티여야 한다
                 "[ ident ]" 은 verb = "does" 일 때만: 행동 이름. does execute cai_mao because P
                 idlist 는 to/with/because/src 에서 멈춘다 *)
actor       = ident | "role" ":" ident ;                             (* role:chancellor — 그 시점의 보유자 *)
verb        = "tells" | "says" | "hails" | "asks" | "lies" | "whispers" | "aside" | "thinks"
            | "sees" | "shows" | "reads" | "writes" | "sends" | "orders" | "decrees" | "does" ;
belief      = ident ("believes" | "doubts") prop [ "because" tref ] ;
attribute   = "attr" word "=" ( number | string | ident ) [ "src" (word | string) ] ;
              (* word = <entity>.<key>: 마지막 "." 앞이 엔티티(character group place thing faction thread), 뒤가 키.
                 장면·사건·기록 안이면 그 시점(바로 앞 시점)의 값을 단언한다. account 안의 단언은 그 기록의 것이다.
                 값: 10진 정수(int, 07 ≡ 7) | 문자열(str) | ident(id: 선언된 이름이면 그 선언, 아니면 그대로의 기호).
                 "attr" 는 예약어가 아니다: 다음 단어가 동사나 believes·doubts 면 attr 라는 이름의 행위·믿음이다.
                 나이처럼 시간에 따라 변하는 값은 시점에 묶는다(attr hamlet.age = 30). 판정은 attribute-conflict 규칙. *)
reader      = "reveal" prop [ "at" tref ] | "withhold" prop "until" tref ;
setup       = "setup" ident ("promise" | "hint" | "symbol") ":" ( prop | string ) ;
payoff      = "payoff" qname ;                                       (* 모듈/복선: macbeth.act1/banquo_kings *)
discourse   = "discourse" "after" tref ;
pragma      = "#!" "allow" ruleid ":" string ;                       (* 바로 다음 문장에 붙는다(sema) *)
render      = "render" BLOCK(rentry) ;
rentry      = rkey rvalue { [","] rvalue } ;
rkey        = "pov" | "pace" | "tension" | "focus" | "omit" | "show" ;
rvalue      = word | string ;

(* 식 *)
prop        = [ "not" ] ident [ "(" [ prop { "," prop } ] ")" ] ; (* 인자 자리의 ident 도 prop 이다 *)
proplist    = prop { "," prop } ;
idlist      = ident { "," ident } ;
tref        = word ;                                                 (* [@] sid [. beat | .end | .born | .died] | start *)
dur         = 숫자 { 숫자 } ("y" | "d" | "h" | "m") ;               (* 1y = 365d. AST Dur 는 N, Unit 과 초 단위 Sec 를 함께 가진다 *)

(* ───── .dieg.md 파일 ─────
   - 1행이 "---" 이면 다음 "---"(또는 "...") 줄까지가 YAML 프론트매터. 닫히지 않으면 unterminated-fence.
   - 0열의 "```sl" ~ "```" 가 언어 블록. 여러 개면 순서대로 이어 붙인다. 닫히지 않으면 unterminated-fence.
   - 나머지는 산문(Prose, 원래 줄 번호 보존). 한 줄 전체가 "<!-- beat:<id> -->" 이면 BeatAnchor.
   - 확장자가 .dieg 이면 파일 전체가 언어 소스다.
   - 파일 맨 앞의 UTF-8 BOM 은 무시한다.

   프론트매터 (yaml.v3 Node, 스칼라는 원문 문자열. 앵커·별칭·병합 키 → yaml-anchor, 모르는 키 → unknown-key)
   생성되는 문장의 위치는 프론트매터의 그 줄이다. 생성 순서:

     module: Q                    → module Q
     import: Q | [Q, …]           → import Q …
     characters|groups|places|things|factions|facts: 맵   (선언 파일)
        id:                        → <kind> id
        id: "Name"                 → <kind> id "Name"
        id: {name: N | [N, …], tier: T, members: [..], knows: K, names: {ko: "…"},
             value: true|false, def: "<prop>"}
                                   → <kind> id "N" … T [= def] [value]  + 블록 members/knows/name
     scene: S  location: L  thread: T   → scene S at L in T   (이후 언어 블록 전체가 이 장면의 몸체)
        when: W | [W, …]           →   when W …
        date: D  time: X           →   when at D X
        discourse: after S         →   discourse after S
        characters: [a, b]         →   enter a, b           (몸체 첫머리)
        characters: [] / mentions: []  → 아무것도 만들지 않는다(빈 목록 = 아무도 없음, exit all 도 없음)
        mentions: [c]              →   mention c
        … 언어 블록 …
        pov: P  render: {k: v, …}  →   render / pov P / k v  (몸체 끝)
        characters 가 있으면       →   exit all              (맨 끝)
     status, mode, rendered: {…}  → 메타데이터(File.Status/Mode/Rendered). 문장을 만들지 않는다.

   값 규칙: 스칼라 값은 한 줄이어야 한다(블록 스칼라 | > 와 여러 줄 스칼라 → syntax "frontmatter values must be single-line").
     값이 필요한 키(module import scene location thread when date time discourse characters mentions pov render)가
     비어 있으면 키 위치에 syntax. 값에서 난 오류는 그 키의 줄, 값 안의 열을 가리킨다.

   dup-decl: 같은 정보를 두 곳에 쓰면 오류.
     같은 YAML 맵 안에서 같은 키 두 번(두 번째 키 위치) / 시간 키(when date time) + 장면 몸체 블록의 when /
     discourse 키 + 블록의 discourse /
     scene 키 + 블록의 scene 머리줄 / characters 의 인물을 블록에서 enter / characters + 블록의 exit all /
     mentions 의 인물을 블록에서 mention / pov·render 키 + 블록 render 의 같은 키 /
     같은 파일 안에서 같은 선언 id 두 번, 같은 장면 id 두 번.
   scene 없이 location/when/date/time/thread/discourse/characters(목록)/mentions/pov/render → syntax. *)
