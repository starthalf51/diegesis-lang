  {
   "id": 10,
   "title": "Diagnostics",
   "description": "diagnostic table: rule, severity, source position, waived or not.",
   "type": "table",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "diegesis-pg"
   },
   "gridPos": {
    "x": 12,
    "y": 72,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "diegesis-pg"
     },
     "format": "table",
     "editorMode": "code",
     "rawQuery": true,
     "rawSql": "SELECT d.rule_id, d.severity, coalesce(s.file || ':' || s.line, '') AS \"file:line\", d.waived, d.message FROM diagnostic d LEFT JOIN src s ON s.work_id = d.work_id AND s.id = d.src_id WHERE d.work_id = ${work:sqlstring} ORDER BY d.severity, d.rule_id, 3"
    }
   ],
   "options": {
    "showHeader": true
