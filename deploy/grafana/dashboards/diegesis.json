 "panels": [
  {
   "id": 1,
   "title": "Character appearance heatmap",
   "description": "Row = character, column = narrative position (ord), cell = number of acts in that scene (darker = more). A character who stands silent is 0. Drawn with the coloured cells of a table panel.",
   "type": "table",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "diegesis-pg"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 12
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "diegesis-pg"
     },
     "format": "table",
     "editorMode": "code",
     "rawQuery": true,
     "rawSql": "SELECT ord, lint_short(entity) AS entity, sum(acts)::int AS acts FROM metric_presence(${work:sqlstring}) GROUP BY 1, 2 ORDER BY 1, 2"
    }
   ],
   "transformations": [
    {
     "id": "groupingToMatrix",
     "options": {
      "columnField": "ord",
      "rowField": "entity",
      "valueField": "acts",
      "emptyValue": "zero"
     }
    }
   ],
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   },
   "fieldConfig": {
    "defaults": {
     "min": 0,
     "color": {
      "mode": "thresholds"
     },
     "custom": {
      "minWidth": 30,
      "align": "center",
      "cellOptions": {
       "type": "color-background",
       "mode": "gradient"
      }
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#1d2230",
        "value": null
       },
       {
        "color": "#2f6fe0",
        "value": 1
       },
       {
        "color": "#e8a33d",
        "value": 3
       },
       {
        "color": "#d9492e",
        "value": 6
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 2,
   "title": "Knowledge asymmetry",
   "description": "Per character: the number of propositions the reader believes true that the character does not know (no/opp). Prophets and omniscient characters are excluded.",
   "type": "barchart",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "diegesis-pg"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "diegesis-pg"
     },
     "format": "table",
     "editorMode": "code",
     "rawQuery": true,
     "rawSql": "SELECT ord, lint_short(entity) AS entity, n FROM metric_asymmetry(${work:sqlstring}) ORDER BY 1, 2"
    }
   ],
   "options": {
    "xField": "ord",
    "stacking": "normal",
    "showValue": "never",
    "xTickLabelRotation": 0,
    "xTickLabelSpacing": 0,
    "barWidth": 0.9,
    "groupWidth": 0.9,
    "legend": {
     "showLegend": true,
     "displayMode": "list",
     "placement": "bottom"
    }
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "fillOpacity": 80,
      "lineWidth": 0
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "ord"
      },
      "properties": [
       {
        "id": "decimals",
        "value": 0
       }
      ]
     }
    ]
   },
   "transformations": [
    {
     "id": "partitionByValues",
     "options": {
      "fields": [
       "entity"
      ],
      "naming": {
       "asLabels": false
      }
     }
    },
    {
     "id": "joinByField",
     "options": {
      "byField": "ord",
      "mode": "outer"
     }
    },
    {
     "id": "renameByRegex",
     "options": {
      "regex": "^n (.*)$",
      "renamePattern": "$1"
     }
    }
   ]
  },
