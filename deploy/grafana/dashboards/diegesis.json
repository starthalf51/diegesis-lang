  {
   "id": 6,
   "title": "Anachrony scatter",
   "description": "x = narrative position (ord), y = story time at scene start (seconds). Only scenes with time constraints (anchored) are plotted. Works without anchors, such as macbeth, chibi and odyssey, give 0 rows and an empty graph (not an error). Drawn with a trend panel that plots only points with a numeric x.",
   "type": "trend",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "diegesis-pg"
